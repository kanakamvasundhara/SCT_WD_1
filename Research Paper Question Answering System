        "\n",
        "from pypdf import PdfReader\n",
        "from sentence_transformers import SentenceTransformer\n",
        "import faiss\n",
        "import numpy as np\n",
        "from transformers import pipeline"
      ],
      "metadata": {
        "id": "DjbdvG_k9qEO"
      },
      "execution_count": 14,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "pdf_file = \"/content/nlp_application.pdf\""
      ],
      "metadata": {
        "id": "o-Ukd_L4-II9"
      },
      "execution_count": 12,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "reader = PdfReader(pdf_file)\n",
        "\n",
        "pages = []\n",
        "\n",
        "for i, page in enumerate(reader.pages):\n",
        "    text = page.extract_text()\n",
        "    if text:\n",
        "        pages.append(text)\n",
        "\n",
        "print(\"Number of pages:\", len(pages))\n",
        "print(\"Text extracted successfully\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "1gZMUKiC_R6N",
        "outputId": "d8a7b1ec-a80d-46e0-f887-15c1c875f210"
      },
      "execution_count": 4,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Number of pages: 15\n",
            "Text extracted successfully\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "chunks = []\n",
        "chunk_size = 500\n",
        "overlap = 100\n",
        "\n",
        "for page_no, text in enumerate(pages, start=1):\n",
        "    words = text.split()\n",
        "\n",
        "    for i in range(0, len(words), chunk_size - overlap):\n",
        "        chunk = \" \".join(words[i:i + chunk_size])\n",
        "\n",
        "        if len(chunk.strip()) > 50:\n",
        "            chunks.append({\n",
        "                \"text\": chunk,\n",
        "                \"page\": page_no\n",
        "            })\n",
        "\n",
        "print(\"Total chunks:\", len(chunks))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "-bOHRH5E_Sgw",
        "outputId": "0513dd51-fde0-4e42-f944-b2c48557aba1"
      },
      "execution_count": 5,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Total chunks: 24\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "model = SentenceTransformer(\"all-MiniLM-L6-v2\")\n",
        "\n",
        "texts = [chunk[\"text\"] for chunk in chunks]\n",
        "\n",
        "embeddings = model.encode(\n",
        "    texts,\n",
        "    convert_to_numpy=True,\n",
        "    show_progress_bar=True\n",
        ")\n",
        "\n",
        "print(\"Embedding shape:\", embeddings.shape)"
      ],
